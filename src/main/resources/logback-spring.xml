<?xml version="1.0" encoding="UTF-8" ?>
<configuration>

  <property name="CONSOLE_PATTERN"
    value="%d{yyyy-MM-dd HH:mm:ss} %magenta([%thread]) %highlight([%-3level]) %cyan(%logger{5}) %green([%X{traceId}]) - %msg %n" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <Pattern>${CONSOLE_PATTERN}</Pattern>
    </encoder>
  </appender>

  <logger name="org.hibernate.SQL" level="DEBUG" additive="false">

  </logger>
  <logger name="org.hibernate.orm.jdbc.bind" level="trace" additive="false">

  </logger>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
