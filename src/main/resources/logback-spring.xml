<?xml version="1.0" encoding="UTF-8" ?>
<configuration>

  <property name="CONSOLE_PATTERN"
    value="%d{yyyy-MM-dd HH:mm:ss} %magenta([%thread]) %highlight([%-3level]) %cyan(%logger{5}) %green([%X{traceId}]) - %replace(%msg){'(password|card|account|orderId)\s*=\s*[^\s,]+', '$1=****'} %n" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <Pattern>${CONSOLE_PATTERN}</Pattern>
    </encoder>
  </appender>

  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/error.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

<!--  <logger name="org.hibernate.SQL" level="DEBUG" additive="false">-->

<!--  </logger>-->
<!--  <logger name="org.hibernate.orm.jdbc.bind" level="trace" additive="false">-->

<!--  </logger>-->

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
    <appender-ref ref="ERROR_FILE"/>
  </root>
</configuration>
